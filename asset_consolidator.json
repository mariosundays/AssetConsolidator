{
    "//": "Asset Consolidator -- Houdini package. HOUDINI_PACKAGE_PATH auto-resolves to this JSON's folder, so no paths need editing.",

    "enable": "houdini_version >= '20.5'",
    "show": true,
    "process_order": 10,

    "hpath": [
        "${HOUDINI_PACKAGE_PATH}/AssetConsolidator"
    ],

    "env": [
        {
            "PYTHONPATH": [
                "${HOUDINI_PACKAGE_PATH}/AssetConsolidator/python",
                { "method": "prepend" }
            ]
        }
    ]
}
